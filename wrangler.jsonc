{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cymatic-resonance",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "conditions": ["browser", "style"],
  "alias": {
    "#tanstack-start-entry": "./src/server.ts",
    "#tanstack-router-entry": "./src/router.tsx",
    "tanstack-start-manifest": "tanstack-start-manifest"
  }
}
